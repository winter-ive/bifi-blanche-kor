---
import "../styles/global.css";
import Ticker from "../components/Ticker.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FloatingIcons from "../components/FloatingIcons.astro";

interface Props {
  title?: string;
  description?: string;
}
const { title = "비피블랑쉬 BIFI BLANCHE | 공식 브랜드 사이트", description = "피부 생태계의 균형을 생각하는 스킨케어 브랜드 비피블랑쉬(BIFI BLANCHE). 브랜드 철학과 스킨케어 제품을 만나보고 네이버 공식 스토어에서 구매하세요." } = Astro.props;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="format-detection" content="telephone=no" />
<meta name="naver-site-verification" content="f25dad838042703bf5c88118fa85eb6d19f14600" />
    <title>{title}</title>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
  </head>
  <body>
    <Ticker />
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <FloatingIcons />
  </body>
</html>
