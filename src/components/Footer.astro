            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--c-white);
    color: var(--c-text-sub);
    padding: 100px 0 60px;
    font-size: 16px;
    line-height: 1.9;
  }
  .footer-inner {
    max-width: var(--site-max);
    margin: 0 auto;
    padding: 0 var(--site-pad);
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 40px;
    flex-wrap: nowrap;
  }

  .brand-col {
    flex: 0 0 auto;
    max-width: 300px;
    margin-top:22px;
  }
  .brand-col .col-title {
    font-size: 16px;
    font-weight: 500;
    color: var(--c-text);
    letter-spacing: 0.06em;
    margin-bottom: 18px;
  }
  .brand-desc {
    font-size: 16px;
    font-weight: 300;
    line-height: 1.4;
    color: var(--c-text-sub);
  }

  .right-cluster {
    flex: 0 0 auto;
    display: flex;
    gap: 60px;
    align-items: flex-start;
  }

  .col {
    min-width: 150px;
    padding-top: 22px;
    border-top: 1px solid var(--c-text);
  }
  .col-title {
    font-size: 16px;
    font-weight: 500;
    color: var(--c-text);
    margin-bottom: 16px;
  }
  .link-list li {font-weight: 300; }
  .link-list a:hover { color: var(--c-text); }
  .col p { font-size: 16px; font-weight: 300; line-height: 1.8; margin: 0; }
  .col p + p { margin-top: 2px; }
  .col p strong { color: var(--c-text); font-weight: 500; margin-right: 6px; }
  .kr-addr { margin-top: 10px !important; }

  .social {
    margin-top: 16px;
    display: flex;
    gap: 12px;
  }
  .social a { color: var(--c-text); opacity: .7; transition: opacity .2s; }
  .social a:hover { opacity: 1; }

  /* Tablet / mobile — stack everything */
  @media (max-width: 1023px) {
    .footer-inner {
      flex-direction: column;
      gap: 40px;
    }
    .right-cluster { gap: 40px; flex-wrap: wrap; }
    .brand-col { max-width: 100%; }
    .col { min-width: 130px; }
  }
  @media (max-width: 640px) {
    .site-footer { padding: 60px 0 40px; }
    .right-cluster { flex-direction: column; gap: 32px; }
    .col { min-width: 0; width: 100%; }
    .col-title { margin-bottom: 10px; }
  }
</style>
