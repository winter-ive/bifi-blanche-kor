---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductSlider from "../components/ProductSlider.astro";
---
<BaseLayout title="Bifi Blanche">
  <!-- Hero -->
  <section class="hero">
    <a class="hero-img" href="https://smartstore.naver.com/bifiblanche/products/13702847278" aria-label="Bifi Blanche brand"></a>
  </section>

  <!-- Product Slider -->
  <ProductSlider />

  <!-- Core Technology -->
  <section class="core">
    <video class="core-video" autoplay muted loop playsinline
      poster="/images/core_bg.jpg" preload="metadata" aria-hidden="true">
      <source src="/images/core-tech_video_pc.mp4" type="video/mp4" media="(min-width: 900px)" />
      <source src="/images/core-tech_video_mobile.mp4" type="video/mp4" />
    </video>
    <div class="core-inner">
      <h2 class="core-title">CORE TECHNOLOGY</h2>
      <p class="core-sub">신비 콤플렉스™</p>
      <p class="core-desc">
        Probiotics와 Prebiotics의 시너지, SynBiotics를 기반으로 설계된 성분 복합체.<br />
        피부 장벽 개선, 피부 생태계 균형, 주름 개선, 트러블 개선에 효과를 발휘하며<br />
        사균체(Heat-killed) 방식으로 안정성과 효과를 극대화했습니다.
      </p>
      <div class="core-tags">
        <span class="tag">#LONGEVITY</span>
        <span class="tag">#SKIN BARRIER</span>
        <span class="tag">#MICROBIOME BALANCE</span>
        <span class="tag">#ANTI-WRINKLE</span>
      </div>
    </div>
  </section>

  <!-- Bifi Character section -->
  <section class="story">
    <video class="story-video" autoplay muted loop playsinline
      poster="/images/brand_bg.jpg" preload="metadata" aria-hidden="true">
      <source src="/images/brand_video_pc.mp4" type="video/mp4" media="(min-width: 900px)" />
      <source src="/images/brand_video_mobile.mp4" type="video/mp4" />
    </video>
    <div class="story-overlay">
      <p>
        Bifi sets off again, unwavering in search of purity, hoping that one day,<br />
        with purity, the world will bloom a little brighter.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    width: 100%;
    margin-top: calc(var(--nav-h) * -1);
    background: var(--c-bg);
  }
  .hero-img {
display:block;
    width: 100%;
    height: min(92vh, 970px);
    background: url("/images/main_img.jpg") center/cover no-repeat;
  }

  .core {
    position: relative;
    background: #86823E;
    color: var(--c-bg-olive-text);
    padding: 160px 40px;
    text-align: center;
    overflow: hidden;
  }
  .core-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    pointer-events: none;
  }
  .core-inner {
    max-width: 1280px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }
  .core-title {
    font-size: 26px;
    letter-spacing: var(--ls-display);
    font-weight: 600;
    margin-bottom: 44px;
    color: var(--c-white);
  }
  .core-sub {
    font-size: 22px;
    font-weight: 500;
    margin-bottom: 28px;
    letter-spacing: 0.02em;
    color: var(--c-white);
  }
  .core-desc {
    font-size: 20px;
    font-weight: 300;
    line-height: 1.6;
    margin-bottom: 52px;
    color: var(--c-white);
    opacity: 0.95;
  }
  .core-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
  .tag {
    border: 1px solid var(--c-white);
    color: var(--c-white);
    border-radius: 999px;
    padding: 9px 40px;
    font-size: 14px;
    font-weight: 300;
  }

  .story {
    position: relative;
    width: 100%;
    height: min(72vh, 640px);
    overflow: hidden;
    background: #B5C6D8;
  }
  .story-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
    z-index: 0;
    pointer-events: none;
  }
  .story-overlay {
    position: relative;
    z-index: 1;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--c-white);
    text-align: center;
    padding: 0 20px;
    text-shadow: 0 2px 10px rgba(0,0,0,.18);
  }
  .story-overlay p {
    font-size: 24px;
    line-height: 1.4;
    letter-spacing: 0.01em;
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .hero-img { height: 75vh; }
    .core { padding: 90px 24px; }
    .core-title { font-size: 30px; }
    .core-desc { font-size: 13px; }
    .core-tags { gap: 8px; }
    .tag { padding: 8px 14px; font-size: 11px; }
    .story { height: 60vh; }
    .story-overlay p { font-size: 14px; }
  }
</style>
