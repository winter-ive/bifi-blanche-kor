---
// 챗봇 아이콘(추후 서비스 연동 예정) + 맨 위로 이동 버튼
---
<div class="floating-icons">
  <button class="chatbot-btn" id="chatbotBtn" aria-label="Open chatbot">
    <img src="/images/bot_icon_3x.png" alt="" width="56" height="56" />
  </button>
  <button class="go-top-btn" id="goTopBtn" aria-label="Go to top">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
      <path d="M6 15L12 9L18 15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>
</div>

<style>
  .floating-icons {
    position: fixed;
    right: 24px;
    bottom: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    z-index: 900;
    align-items: center;
  }
  .chatbot-btn {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    box-shadow: 0 6px 18px rgba(0,0,0,.15);
    overflow: hidden;
    background: var(--c-accent);
    transition: transform .2s ease;
  }
  .chatbot-btn img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .chatbot-btn:hover { transform: translateY(-2px); }

  .go-top-btn {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--c-white);
    border: 1px solid #DDD;
    color: var(--c-text);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0,0,0,.06);
    transition: transform .2s ease, opacity .2s ease;
    opacity: 0;
    pointer-events: none;
  }
  .go-top-btn.visible {
    opacity: 1;
    pointer-events: auto;
  }
  .go-top-btn:hover { transform: translateY(-2px); }

  @media (max-width: 768px) {
    .floating-icons { right: 16px; bottom: 16px; gap: 10px; }
    .chatbot-btn { width: 48px; height: 48px; }
    .go-top-btn { width: 36px; height: 36px; }
  }
</style>

<script>
  const goTop = document.getElementById('goTopBtn');
  const chatbot = document.getElementById('chatbotBtn');
  const onScroll = () => {
    if (!goTop) return;
    if (window.scrollY > 300) goTop.classList.add('visible');
    else goTop.classList.remove('visible');
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
  goTop?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
  chatbot?.addEventListener('click', () => {
    alert('챗봇은 준비 중입니다.');
  });
</script>
